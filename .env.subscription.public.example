# .env.subscription.public.example
# ------------------------------------------------------------
# Cocolon Phase 3: Expo / React Native public env sample
# ------------------------------------------------------------

EXPO_PUBLIC_MYMODEL_API_URL=https://api.example.com
EXPO_PUBLIC_IOS_BUNDLE_ID=com.example.cocolon
EXPO_PUBLIC_ANDROID_PACKAGE_NAME=com.example.cocolon

EXPO_PUBLIC_IAP_PLUS_SKU_IOS=cocolon_plus_monthly
EXPO_PUBLIC_IAP_PLUS_SKU_ANDROID=cocolon_plus_monthly

# Optional while Premium is still not on sale
EXPO_PUBLIC_IAP_PREMIUM_SKU_IOS=cocolon_premium_monthly
EXPO_PUBLIC_IAP_PREMIUM_SKU_ANDROID=cocolon_premium_monthly

EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
