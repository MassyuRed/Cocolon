        "repository_key": "mashos-api",
        "family": "python",
        "project_name": "mashos-api",
        "required": true
      },
      {
        "run_id": "mashos_api_typescript",
        "repository_key": "mashos-api",
        "family": "typescript",
        "required": true
      }
    ]
  },
  "profiles": {
