          "checkout_ref": "main",
          "expected_head": "e3aed2d9728b9b79976ef0b8805b4e262f272f4e",
          "role": "RN application, premise documents, and product structure owners"
        },
        "mashos-api": {
          "repository": "MassyuRed/mashos-api",
          "checkout_ref": "main",
          "expected_head": "a8ca4ddf7b7ae76bf7b3d73e74e3a5808d623428",
          "role": "FastAPI backend, services, engines, storage, workers, and contracts"
        }
      }
    },
    "cmee_working": {
