      "current_product_owner_adoption_state": "IMPLEMENTED_NOT_ACCEPTED",
      "im10_state": "NON_PASS",
      "candidate_ready": false,
      "production_effect": 0,
      "automatic_progression": false,
      "repositories": {
        "Cocolon": {
          "repository": "MassyuRed/Cocolon",
          "checkout_ref": "agent/three-core-cmee-current-structure-20260815",
          "expected_head": "8e3c26f66e13c26e82349c4e02415e149e5e3943",
          "role": "RN application, fresh whole-product baseline, structure maps, current weekly review, observation/model comparison and detailed product originals on Draft PR #30"
