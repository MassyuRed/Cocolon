{
  "schema_version": "cocolon.system_context.workspace_profiles.v1",
  "default_workspace": "cmee_working",
  "code_index": {
    "schema_version": "cocolon.system_context.code_index_configuration.v1",
    "toolchain": {
      "node_major": "20",
      "node": "20.20.2",
      "npm": "10.8.2",
      "python": "3.11.16",
      "platform": "linux/amd64",
      "typescript_syntax": "5.2.2",
      "scip_cli": "v0.7.1",
      "scip_typescript": "0.4.0",
      "scip_python": "0.6.6",
      "environment_lock": ".devcontainer/system-context-toolchain.lock.json"
    },
    "runs": [
      {
        "run_id": "cocolon_typescript",
        "repository_key": "Cocolon",
        "family": "typescript",
        "required": true
      },
      {
        "run_id": "mashos_api_python",
        "repository_key": "mashos-api",
        "family": "python",
        "project_name": "mashos-api",
        "required": true
      },
      {
        "run_id": "mashos_api_typescript",
        "repository_key": "mashos-api",
        "family": "typescript",
        "required": true
      }
    ]
  },
  "profiles": {
    "production_main": {
      "purpose": "Merged production baseline for RN and API",
      "repositories": {
        "Cocolon": {
          "repository": "MassyuRed/Cocolon",
          "checkout_ref": "main",
          "expected_head": "de9c3d985053bbaaa7fc0d396e688cc2097ece40",
          "role": "RN application, premise documents, and product structure owners"
        },
        "mashos-api": {
          "repository": "MassyuRed/mashos-api",
          "checkout_ref": "main",
          "expected_head": "a8ca4ddf7b7ae76bf7b3d73e74e3a5808d623428",
          "role": "FastAPI backend, services, engines, storage, workers, and contracts"
        }
      }
    },
    "cmee_working": {
      "purpose": "CMEE working material view: exact product Draft PR #30 plus exact disabled API Draft PR #3; current owner remains IMPLEMENTED_NOT_ACCEPTED with IM10=NON_PASS and automatic progression disabled; System Context implementation is supplied independently by PR #37",
      "current_product_owner_adoption_state": "IMPLEMENTED_NOT_ACCEPTED",
      "im10_state": "NON_PASS",
      "candidate_ready": false,
      "production_effect": 0,
      "automatic_progression": false,
      "repositories": {
        "Cocolon": {
          "repository": "MassyuRed/Cocolon",
          "checkout_ref": "agent/three-core-cmee-current-structure-20260815",
          "expected_head": "97b25c146ad41f87d5859e450e48face9de65ea0",
          "role": "RN application, premise documents, CMEE design, and product structure material"
        },
        "mashos-api": {
          "repository": "MassyuRed/mashos-api",
          "checkout_ref": "agent/cmee-v1a-i1sx-source-explicit-20260815",
          "expected_head": "0476459b5134d2d33fbec6442c0710ffc40db88b",
          "role": "FastAPI backend plus disabled CMEE inherited-owner implementation Draft PR #3"
        }
      }
    },
    "cycle001_working": {
      "purpose": "Cycle001 Response3 working view without mixing it into CMEE",
      "repositories": {
        "Cocolon": {
          "repository": "MassyuRed/Cocolon",
          "checkout_ref": "agent/cycle001-response3-acceptance-20260814",
          "expected_head": "0854e21f92f841fd2cfdcef08b9e3117fc93f96a",
          "role": "Cycle001 current navigation Draft PR #29"
        },
        "mashos-api": {
          "repository": "MassyuRed/mashos-api",
          "checkout_ref": "agent/cycle001-response3-product-quality-20260814",
          "expected_head": "958c1b53f5b5894691e0b10e2d991fb8236d9f6f",
