{
  "schema_version": "cocolon.system_context.workspace_profiles.v1",
  "default_workspace": "cmee_working",
  "code_index": {
    "schema_version": "cocolon.system_context.code_index_configuration.v1",
    "toolchain": {
      "node_major": "20",
      "node": "20.20.2",
      "npm": "10.8.2",
