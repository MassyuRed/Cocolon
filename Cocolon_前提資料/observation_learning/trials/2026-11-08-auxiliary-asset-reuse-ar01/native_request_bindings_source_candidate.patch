+def prepare_natural_request_bindings(request):
+    """Project bounded request roles from native source, without old authors.
+
+    Reuse preparation's admitted source identity and the existing finite
+    witness. Each role has its own target ref. A missing argument is scoped
+    to this clause; an unestablished acceptance is NOT a person-stated gap,
+    nor a claim that no other clause states acceptance. No model receipt or
+    matching quote can self-select this semantic interpretation.
+    """
+    material = prepare_emlis(request)
+    payload = material.payload()
+    control = payload["control"]
+    if (len(payload["sources"]) != 1 or control["frame_feedback"]
+            or control["rejected_frame_keys"] or control["probe_only"]):
+        return ()
+    source = payload["sources"][0]
+    from .natural_reply_cognition import source_context_allows_finite_hints
+    from .natural_reply_meaning import prepare_meaning_support, _SOURCE_UPDATE
+    fields = source["text_fields"]
+    texts = tuple(fields.get(name) or "" for name in ("memo", "memo_action"))
+    if (not source_context_allows_finite_hints(*texts)
+            or any(_SOURCE_UPDATE.search(text) for text in texts)):
+        return ()
+    support = prepare_meaning_support(dict(current=fields,
+        current_input_id=source["source_id"], current_answers=[],
+        past_user_records=[], user_frame_feedback=[]))
+    bindings = []
+    for witness in support["witnesses"]:
+        if not (witness["source_construction"] == "PLAIN_FINITE"
+                and witness["predicate"] == "頼む" and witness["voice"] == "passive"
+                and witness["subject"] == witness["counterpart"] == "UNSTATED"
+                and (witness["agent"] == "SELF" or witness["agent"].startswith("WRITTEN:"))
+                and (witness["polarity"], witness["modality"], witness["temporal_scope"])
+                    == ("positive", "fact", "past")):
+            continue
+        field = witness["source_path"].removeprefix("current.")
+        start, end = witness["scalar_start"], witness["scalar_end"]
+        # Coordinate equality is an integrity check AFTER finite interpretation.
+        # It is never used to adopt a model-written role.
+        if fields[field][start:end] != witness["raw_text"]:
+            raise ValueError("natural_request_source_slice_invalid")
+        anchor = dict(source_id=source["source_id"], source_version=source["source_version"],
+            envelope_id=source["envelope_id"], source_commitment=source["source_commitment"],
+            field_path=field, scalar_start=start, scalar_end=end, quote=witness["raw_text"])
+        claim_ref = identity("natural-request", anchor, witness["predicate"], witness["agent"])
+        slice_ref = identity("natural-request-slice", anchor)
+        axes = []
+        for dimension, status, entity in (
+                ("REQUESTER", "WRITTEN_ARGUMENT", witness["agent"]),
+                ("RECIPIENT", "OMITTED_IN_CLAUSE", None),
+                ("ACCEPTANCE", "NOT_ESTABLISHED_BY_REQUEST", None)):
+            axes.append(dict(target_ref=identity("natural-request-target", claim_ref, dimension),
+                claim_ref=claim_ref, dimension=dimension, status=status,
+                entity=entity, source_slice_refs=[slice_ref]))
+        bindings.append(dict(claim_ref=claim_ref, predicate="頼む", polarity="positive",
+            modality="fact", temporal_scope="past", relative_day=witness["relative_day"],
+            source_slice_ref=slice_ref, source_slice=anchor, targets=axes,
+            interpretation_scope="FINITE_PASSIVE_REQUEST_CLAUSE_ONLY"))
+    return tuple(bindings)
+
+
