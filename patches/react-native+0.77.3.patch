+// Piece observes the existing TextKit objects. No KVC/private-ivar read.
+- (NSTextStorage *)cocolonPieceTextStorage { return _textStorage; }
+- (CGRect)cocolonPieceContentFrame { return _contentFrame; }
+
+// Plainness is required only by the optional Piece v3 inspector. It never
+// suppresses the normal drawing of other RN Text instances.
+- (BOOL)cocolonPieceIsPlainText
+{
+  if (!_textStorage || _highlightLayer) return NO;
+  __block BOOL plain = YES;
+  [_textStorage enumerateAttributesInRange:NSMakeRange(0, _textStorage.length) options:0
+    usingBlock:^(NSDictionary<NSAttributedStringKey, id> *attributes, NSRange range, BOOL *stop) {
+      UIColor *background = attributes[NSBackgroundColorAttributeName];
+      if (attributes[NSAttachmentAttributeName] || attributes[NSShadowAttributeName] ||
+          [attributes[RCTTextAttributesIsHighlightedAttributeName] boolValue] ||
+          (background && (![background isKindOfClass:UIColor.class] || CGColorGetAlpha(background.CGColor) != 0))) {
+        plain = NO; *stop = YES;
+      }
+    }];
+  return plain;
+}
+
+// The exact two original paint calls are shared with the unclipped reference.
+// Layout/attributes/view state and the normal highlight path are not mutated.
+- (void)cocolonPiecePaintGlyphRange:(NSRange)glyphRange
+{
+  NSLayoutManager *layoutManager = _textStorage.layoutManagers.firstObject;
+  [layoutManager drawBackgroundForGlyphRange:glyphRange atPoint:_contentFrame.origin];
+  [layoutManager drawGlyphsForGlyphRange:glyphRange atPoint:_contentFrame.origin];
 }
 
