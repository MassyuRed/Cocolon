diff --git a/node_modules/react-native-reanimated/Common/cpp/ReanimatedRuntime/WorkletRuntimeDecorator.cpp b/node_modules/react-native-reanimated/Common/cpp/ReanimatedRuntime/WorkletRuntimeDecorator.cpp
--- a/node_modules/react-native-reanimated/Common/cpp/ReanimatedRuntime/WorkletRuntimeDecorator.cpp
+++ b/node_modules/react-native-reanimated/Common/cpp/ReanimatedRuntime/WorkletRuntimeDecorator.cpp
@@ -3,6 +3,7 @@
 #include "ReanimatedJSIUtils.h"
 #include "Shareables.h"
 #include "WorkletRuntime.h"
+#include <vector>
 
 #ifdef ANDROID
 #include "Logger.h"
@@ -105,13 +106,14 @@
