+- (NSString *)bitmapBinding;
+@end
+static NSArray<UIView *> *CocolonPieceBitmapViews(UIView *root) {
+  NSMutableArray<UIView *> *pending=[NSMutableArray arrayWithObject:root], *result=[NSMutableArray new];
+  while(pending.count) {
